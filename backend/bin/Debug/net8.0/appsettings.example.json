{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=visitor_reports;Username=postgres;Password=password"
  },
  "SmtpSettings": {
    "Host": "smtp.example.com",
    "Port": 587,
    "Username": "user@example.com",
    "Password": "password",
    "FromEmail": "reports@example.com",
    "FromName": "Reports"
  },
  "ReportSettings": {
    "AsyncExportThreshold": 1000,
    "AsyncExportTimeoutMinutes": 5,
    "ExcelExportMaxRows": 100000,
    "PdfExportMaxPages": 500,
    "DownloadLinkExpiryHours": 24,
    "MaxScheduledReports": 50
  },
  "Security": {
    "DefaultIdMaskFormat": "XXXX-XXXX-{last4}",
    "AuditLogRetentionDays": 90
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-change-in-production",
    "Issuer": "http://localhost:8000",
    "ExpiryMinutes": 60
  }
}
