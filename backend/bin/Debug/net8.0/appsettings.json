{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host={DB_HOST};Port=5432;Database={DB_NAME};Username={DB_USERNAME};Password={DB_PASSWORD}"
  },
  "SmtpSettings": {
    "Host": "{SMTP_HOST}",
    "Port": 587,
    "Username": "{SMTP_USER}",
    "Password": "{SMTP_PASSWORD}",
    "FromEmail": "reports@visitormanagement.com",
    "FromName": "Visitor Management Reports"
  },
  "ReportSettings": {
    "AsyncExportThreshold": 1000,
    "AsyncExportTimeoutMinutes": 5,
    "ExcelExportMaxRows": 100000,
    "PdfExportMaxPages": 500,
    "DownloadLinkExpiryHours": 24,
    "MaxScheduledReports": 50
  },
  "Security": {
    "DefaultIdMaskFormat": "XXXX-XXXX-{last4}",
    "AuditLogRetentionDays": 90
  },
  "JwtSettings": {
    "SecretKey": "{JWT_SECRET_KEY}",
    "Issuer": "{JWT_ISSUER}",
    "ExpiryMinutes": 60
  }
}
